{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Don't look up this project's own modules on Maven Central",
      "matchPackageNames": [
        "/^com\\.github\\.t1:wunderbar/"
      ],
      "enabled": false
    },
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ]
}
